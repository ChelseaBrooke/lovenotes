{
  "expo": {
    "name": "lovenotes",
    "slug": "lovenotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lovenotes",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lovenotes.app"
    },
    "android": {
      "package": "com.lovenotes.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FBF7F1"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "lovenotes needs access to your photos so you can pin them to your board."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
